# Valores ficticios para el demo local. Copia este archivo a .env
# y cámbialos si quieres. No pongas aquí una clave de un servicio real.
POSTGRES_USER=estudia
POSTGRES_PASSWORD=clave-ficticia-de-ejemplo
POSTGRES_DB=inventario
POSTGRES_HOST=localhost

# Puertos publicados en TU máquina. La base de datos no publica ninguno.
FRONTEND_PORT=8080
BACKEND_PORT=8000
